# VayuSutra APIx - Environment Configuration (copy to .env and adjust)
# NEVER commit real secrets. This file is the safe template.

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO

# Server
PORT=8000
# HOST is handled by uvicorn args; bind 0.0.0.0 inside containers

# Database
# SQLite (default) — set to a custom path to relocate the database.
VAYUSUTRA_DB_PATH=
# Use an in-memory SQLite DB (serverless-friendly; data is not persisted across cold starts).
VAYUSUTRA_DB_PATH uses a file-backed SQLite (repo data dir, or /tmp fallback on read-only filesystems).

# CORS (comma-separated origins; use specific origins in production, not "*")
VAYUSUTRA_CORS_ORIGINS=*

# Ingestion worker
# Disable the background worker daemon in stateless/serverless runtimes (e.g. Vercel).
VAYUSUTRA_WORKER=1
VAYUSUTRA_SEED_DAYS=8
WORKER_INTERVAL_SECONDS=60
WORKER_AUTO_TRAIN_CYCLES=5

# Model
MODEL_ARTIFACT_PATH=

# Alert channels (future integrations; not required for local operation)
# ALERT_EMAIL_FROM=
# ALERT_WEBHOOK_URL=

# Prometheus metrics enabled by default (no external service required)
PROMETHEUS_ENABLED=true
